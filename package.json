{
  "name": "industrial-asset-graph",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run typecheck:server && vite build",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "backend:dev": "tsx watch server/api.ts",
    "backend:start": "tsx server/api.ts",
    "test:backend:live": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/live-integration-check.ps1",
    "preview": "vite preview",
    "test": "vitest run",
    "test:visual": "python scripts/dashboard-visual-check.py",
    "verify:data": "tsx scripts/verify-facility.ts",
    "verify:visual-contract": "python scripts/verify-visual-contract.py"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
