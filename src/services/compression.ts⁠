import LZString from 'lz-string';

export const CompressionService = {
  // Compresses any JSON object or string and tags it with a lightning bolt identifier
  compress: (data: object | string): string => {
    const str = typeof data === 'string' ? data : JSON.stringify(data);
    return '⚡' + LZString.compressToUTF16(str);
  },

  // Safely detects and decompresses tagged strings back to their original form
  decompress: <T>(compressedStr: string): T | string => {
    if (!compressedStr || !compressedStr.startsWith('⚡')) return compressedStr;
    const cleanStr = compressedStr.substring(1);
    const decompressed = LZString.decompressFromUTF16(cleanStr);
    
    if (!decompressed) return '';
    
    try {
      return JSON.parse(decompressed) as T;
    } catch {
      return decompressed as unknown as T;
    }
  }
};
