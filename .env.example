# Supabase browser configuration (safe to expose in the frontend bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Shared API URL used by the local/connected sync transport
VITE_IAG_API_URL=http://127.0.0.1:8787

# Server-side Supabase project URL for public JWKS verification.
SUPABASE_URL=https://your-project.supabase.co
# Optional legacy HS256 fallback; do not use this when JWT Keys/JWKS are enabled.
SUPABASE_JWT_SECRET=

# Gemini map planner: server / Supabase Edge Function secret only.
# Use an AI Studio project on the free tier; do not enable billing.
GEMINI_API_KEY=
